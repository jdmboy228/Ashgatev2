<?xml version="1.0" encoding="utf-8"?>
<!-- The screen's main button: the orange pill with the system ripple on top. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ag_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ag_accent" />
            <corners android:radius="@dimen/ag_button_radius" />
        </shape>
    </item>
</ripple>
