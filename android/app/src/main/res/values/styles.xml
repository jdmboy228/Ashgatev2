<?xml version="1.0" encoding="utf-8"?>
<!-- «Тишина» has only a dark theme, so values-night is the same. -->
<resources>
    <color name="accent">@color/ag_accent</color>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ag_bg</item>
        <item name="android:statusBarColor">@color/ag_bg</item>
        <item name="android:navigationBarColor">@color/ag_bg</item>
        <item name="android:colorAccent">@color/ag_accent</item>
        <item name="android:colorPrimary">@color/ag_bg</item>
        <item name="android:colorPrimaryDark">@color/ag_bg</item>
        <item name="android:windowAnimationStyle">@style/ScreenAnimation</item>
    </style>
    <!-- The profile form is not in the design: it keeps its ActionBar, in the design's colors. -->
    <style name="AppTheme.Form" parent="android:Theme.Material">
        <item name="android:windowBackground">@color/ag_bg</item>
        <item name="android:statusBarColor">@color/ag_bg</item>
        <item name="android:navigationBarColor">@color/ag_bg</item>
        <item name="android:colorPrimary">@color/ag_bg</item>
        <item name="android:colorAccent">@color/ag_accent</item>
        <item name="android:windowAnimationStyle">@style/ScreenAnimation</item>
    </style>
    <!-- Screens slide in from the right and back out to it. Follows the system animation scale. -->
    <style name="ScreenAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>
</resources>
