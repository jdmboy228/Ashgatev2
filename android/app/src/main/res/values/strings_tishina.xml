<?xml version="1.0" encoding="utf-8"?>
<!-- Новые строки для «Тишины». Существующие строки (state_on, connect, disconnect, profile, apps,
     profiles, no_profiles, need_profile, need_apps, no_vpn_permission …) НЕ дублировать — использовать их.
     Пометка derived = в макете такого текста нет, он выведен минимально для открытого состояния. -->
<resources>
    <!-- Главная: заголовок по состоянию -->
    <string name="title_on">Туннель включён</string>
    <string name="title_starting">Туннель включается</string>          <!-- derived -->
    <string name="title_off">Туннель выключен</string>                 <!-- derived -->

    <!-- Главная: строка под заголовком. В макете «6 приложений идут через Швецию»;
         склонять название профиля автоматически нельзя, поэтому «через туннель». -->
    <!-- one / few / many: picked by RuPlural, not by the phone language. -->
    <string-array name="sub_on">
        <item>%d приложение идёт через туннель</item>
        <item>%d приложения идут через туннель</item>
        <item>%d приложений идут через туннель</item>
    </string-array>
    <!-- derived; one / few / many as above -->
    <string-array name="sub_off">
        <item>%d приложение пойдёт через туннель</item>
        <item>%d приложения пойдут через туннель</item>
        <item>%d приложений пойдут через туннель</item>
    </string-array>

    <!-- Главная: строки -->
    <string name="row_russia">Россия</string>
    <string name="row_russia_value">напрямую</string>
    <string name="apps_of">%1$d из %2$d</string>

    <!-- Приложения -->
    <string name="apps_sub">Через туннель идут только отмеченные</string>
    <string name="apps_note">Системные загрузки и ссылки, открытые в других приложениях, идут мимо туннеля</string>
    <string name="apps_rest">ОСТАЛЬНЫЕ · %d</string>

    <!-- Профили -->
    <string name="profiles_sub">Удерживайте профиль, чтобы изменить</string>
    <string name="add_profile">Добавить профиль</string>

    <!-- Доступность -->
    <string name="back">Назад</string>                                  <!-- derived, contentDescription -->
</resources>
